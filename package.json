{
  "name": "CXAI-api-testing-framework",
  "version": "1.0.0",
  "description": "API testing project using Cypress with Jest-style assertions and GitHub Actions integration",
  "scripts": {
    "cy:run": "cypress run",
    "test": "cypress run || exit 0",
    "merge-reports": "mochawesome-merge cypress/reports/dev/mochawesome/*.json -o mochawesome.json",
    "stg-merge-reports": "mochawesome-merge cypress/reports/stg/mochawesome/*.json -o mochawesome.json",
    "generate-report": "marge mochawesome.json --reportDir cypress/reports --inline",
    "dev-clean-reports": "rimraf cypress/reports/dev mochawesome-dev.json",
    "stg-clean-reports": "rimraf cypress/reports/stg mochawesome-stg.json",
    "clean-reports": "rimraf cypress/reports mochawesome.json",
    "report": "npm run merge-reports && npm run generate-report",
    "stg:report": "npm run clean-reports && npm run test && npm run stg-merge-reports && npm run generate-report",
    "test:report": "npm run clean-reports && npm run test && npm run report",
    "test:report:dev": "cross-env ENV_NAME=dev npm run test:report",
    "test:report:stg": "cross-env ENV_NAME=stg npm run stg:report",
    "test:report:prod": "cross-env ENV_NAME=prod npm run test:report"
  },
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^23.0.0",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.5",
    "ajv": "^8.12.0",
    "cross-env": "^10.0.0",
    "cypress": "^15.4.0",
    "cypress-multi-reporters": "^2.0.5",
    "cypress-wait-until": "^3.0.2",
    "dotenv": "^16.3.1",
    "esbuild": "^0.25.9",
    "marge": "^1.0.1",
    "mochawesome": "^7.1.4",
    "mochawesome-merge": "^5.0.0",
    "mochawesome-report-generator": "^6.3.0",
    "rimraf": "^6.0.1"
  },
  "dependencies": {
    "mssql": "^11.0.1",
    "pg": "^8.16.3",
    "uuid": "^11.1.0"
  }
}
